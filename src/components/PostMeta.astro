---
import { Icon } from "astro-icon/components";

import { formatPostDateForDisplay, formatPostDateForList } from "../utils/date-utils";
import { url, getDir } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	hideUpdateDate?: boolean;
	hidePublishedDate?: boolean;
	slug?: string;
	isListView?: boolean;
}
const {
	published,
	updated,
	hideUpdateDate = false,
	hidePublishedDate = false,
	slug,
	isListView = false,
} = Astro.props;
const className = Astro.props.class;

const formatDate = isListView ? formatPostDateForList : formatPostDateForDisplay;
---

<div class:list={["flex flex-wrap text-neutral-400 items-center gap-4 gap-x-4 gap-y-2", className]}>
    {!hidePublishedDate && (
        <div class="flex items-center">
            <div class="meta-icon">
                <Icon name="material-symbols:schedule-outline-rounded" class="text-xl"></Icon>
            </div>
            <span class="text-50 text-sm font-medium">{formatDate(published)}</span>
        </div>
    )}

    {!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
        <div class="flex items-center">
            <div class="meta-icon"
            >
                <Icon name="material-symbols:edit-calendar-outline-rounded" class="text-xl"></Icon>
            </div>
            <span class="text-50 text-sm font-medium">{formatDate(updated)}</span>
        </div>
    )}
</div>
